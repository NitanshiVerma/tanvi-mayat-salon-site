# Copy this file to .env.local (local dev) and set the same variables in
# your Netlify site settings (Site configuration > Environment variables)
# for production.

# --- Database ---
# Locally, leave DATABASE_URL unset — the app will use a local SQLite file
# at data/salon.db automatically. Nothing to configure for local dev.
#
# On Netlify (and any serverless host), the filesystem resets on every
# deploy, so you need a hosted database. Turso is a free, SQLite-compatible
# host that works as a drop-in swap — no code changes needed, just set
# these two variables:
#
#   1. Go to https://turso.tech and sign up (free tier is generous)
#   2. Install their CLI or use the dashboard to create a database
#   3. Copy the database URL and an auth token into the variables below
#
# DATABASE_URL=libsql://your-db-name-yourusername.turso.io
# DATABASE_AUTH_TOKEN=your_turso_auth_token

# --- Email (contact form + booking notifications) ---
# Example values below are for Gmail — you'll need an "App Password"
# (Google Account > Security > 2-Step Verification > App Passwords),
# NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your_16_char_app_password

# Where contact-form leads and booking requests get emailed to.
CONTACT_TO_EMAIL=hello@tanvimayatsalon.com

# --- Admin dashboard (/admin) ---
# Password to log into /admin/dashboard.
ADMIN_PASSWORD=choose_a_strong_password

# Random secret used to sign admin login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=replace_with_a_long_random_string
